## Prioritized connections
# Extra DB connections a policy can grant to prioritize some users' DB access
# (e.g. two pgbouncer pools over one Postgres). Each connection inherits the base
# DB_* config; set only what differs. A request routes to the highest-priority
# connection among the base pool and the ones its user's policies grant. The base
# (DB_*) pool is the floor: at equal priority any granted connection outranks it,
# so raise its priority below to make it win.
# DB_BASE_CONNECTION_NAME="base"  # name a policy uses to grant the base DB_* pool
# DB_BASE_CONNECTION_PRIORITY=0  # raise so the base pool can outrank grants
# DB_CONNECTIONS="premium,shares"
# DB_CONNECTION_PREMIUM_DATABASE="directus_premium"  # the pgbouncer pool db
# DB_CONNECTION_PREMIUM_POOL__MAX=40  # knex client pool cap (per process), not pgbouncer's
# DB_CONNECTION_PREMIUM_PRIORITY=100
# DB_CONNECTION_SHARES_DATABASE="directus_shares"  # a small, capped pgbouncer pool
# DB_CONNECTION_SHARES_POOL__MAX=5
# Route anonymous public-share traffic to its own connection so it can't starve
# the base pool. Must name a configured connection (or the base pool); a small,
# dedicated pool — never the premium one.
# DB_PUBLIC_SHARE_CONNECTION_NAME="shares"

####################################################################################################
### Rate Limiting

# Whether or not to enable rate limiting on the API [false]
RATE_LIMITER_ENABLED=false

# Where to store the rate limiter counts [memory]
# memory, redis
RATE_LIMITER_STORE=memory

# The amount of allowed hits per duration [50]
RATE_LIMITER_POINTS=25

# The time window in seconds in which the hits are counted [1]
RATE_LIMITER_DURATION=1

####################################################################################################
### Caching

# Whether or not caching is enabled. [false]
CACHE_ENABLED=false

# How long the cache is persisted ["5m"]
# CACHE_TTL="30m"

# How to scope the cache data ["scalabus"]
# CACHE_NAMESPACE="scalabus"

# Automatically purge the cache on create, update, and delete actions. [false]
# CACHE_AUTO_PURGE=true

# How `CACHE_AUTO_PURGE` invalidates: `scoped` (requires CACHE_STORE=redis) drops only entries whose
# response read the mutated collection; `full` flushes the whole cache on every mutation. With any
# other store `scoped` falls back to `full`. [scoped]
# CACHE_AUTO_PURGE_MODE=full

# List of collections that prevent cache purging when `CACHE_AUTO_PURGE` is enabled. ["directus_activity,directus_presets"]
# CACHE_AUTO_PURGE_IGNORE_LIST="directus_activity,directus_presets"

# Request dimensions folded into the cache key so a header-varying response
# isn't served across callers. The response language (Accept-Language,
# normalized primary tag) is ALWAYS keyed — no config needed.
#   - CACHE_VARY_CONTENT_TYPES: formats a cached endpoint content-negotiates
#     on, via req.accepts(<list>). Defaults to json,csv,yaml — safe because
#     browsers/SDKs collapse to json (only an explicit text/csv etc. splits).
#     Do NOT add xml/html: browsers send them high-q in Accept, so this would
#     split ALL browser traffic into that bucket. ["json,csv,yaml"]
#   - CACHE_VARY_REQUEST_HEADERS: exact header names or `*` globs a hook
#     reshapes the body from (tenant/feature-flag). Opt-in (empty). Globs
#     auto-skip proxy/tracing headers (x-forwarded-*, x-request-id, cf-ray,
#     …) so a broad `x-*` can't disable the cache; name one exactly to
#     override. ["x-tenant-id,x-feature-*"]
#   - CACHE_VARY_REQUEST_HEADERS_EXCLUDED: extra headers (names or globs) to
#     add to that built-in glob denylist, for platform per-request headers
#     it doesn't already cover. ["x-my-lb-*"]
# CACHE_VARY_CONTENT_TYPES="json,csv,yaml"
# CACHE_VARY_REQUEST_HEADERS="x-tenant-id"

# Flush the cache once on boot when the running build changed, so a code-only deploy (an extension or
# core reshaping change with no migration and no version bump) doesn't keep serving the previous
# build's response shape until CACHE_TTL expires. Only acts with CACHE_STORE=redis. [true]
# CACHE_AUTO_FLUSH_ON_DEPLOY=false

# Overrides the core build identity used by `CACHE_AUTO_FLUSH_ON_DEPLOY`. Set it to a per-build value
# (e.g. the git commit SHA) when directus/version is pinned; unset, it falls back to the commit baked
# in at build time, then `RAILWAY_GIT_COMMIT_SHA`, then the directus version string. Required for a
# pinned-version build with no baked commit (a tarball build with no .git) to detect core changes.
# CACHE_BUILD_ID="<git-commit-sha>"

# memory | redis
CACHE_STORE=memory

# Opt-in: track cache hit/miss telemetry in Redis (needs CACHE_STORE=redis) to power the admin cache page. [false]
# CACHE_STATS_ENABLED=true

# How long cache-telemetry rows are kept; a daily reap prunes older ones (bounds table growth on every DB). ["30d"]
# CACHE_STATS_RETENTION="30d"

# Auto-disable stats collection when the directus_cache_events table grows past this size (Postgres only). ["2gb"]
# CACHE_STATS_MAX_BYTES="2gb"

# Auto-disable stats collection when the Redis event buffer exceeds this many entries. [100000]
# CACHE_STATS_MAX_BUFFER=100000

# How long a miss can still be attributed to a just-expired entry (gap-since-expiry lookback). ["1h"]
# CACHE_STATS_GAP_LOOKBACK="1h"

# How long assets will be cached for in the browser. Sets the max-age value of the Cache-Control header ["30d"]
ASSETS_CACHE_TTL="30d"

#####################################################################################
### Diagnostics MCP

# Serve a read-only MCP endpoint at /mcp exposing the diagnostic reads (the
# processes tree, the cache listings, anomalies, latencies, timeseries and
# telemetry state) as tools an LLM agent can call. Off by default. [false]
# MCP_ENABLED=false

# Bearer tokens accepted as `Authorization: Mcp <token>` on that endpoint, for
# agents that have no login. A token reads every diagnostic tool, which is what
# an admin can read — treat one as an admin credential. Unset by default.
# MCP_TOKENS="a-long-random-token,another"

#####################################################################################
### Processes

# Serve the admin Processes page (Settings -> Processes). Admin-only either
# way; turn it off to remove the endpoint entirely. [true]
# PROCESSES_REPORT_ENABLED=true

# Which halves of each process the report carries: "stats" (supervisor +
# runtime numbers) and "env" (the resolved environment, redacted by key
# shape). Drop "env" to keep the page without reporting any env at all.
# ["stats,env"]
# PROCESSES_REPORT_DETAILS="stats,env"

# Name this deployment reports itself under — the top level of the tree.
# Defaults to the platform's service name, else the PM2 app name.
# PROCESSES_SERVICE_NAME="directus"

# How long replies from the other replicas are collected for before the tree
# is rendered. A replica that misses the window is reported, not omitted.
# ["750ms"]
# PROCESSES_COLLECT_TIMEOUT="750ms"

